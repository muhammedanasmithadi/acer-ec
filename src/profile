#!/bin/bash
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

SYS=/sys/kernel/acer_fanctl
CACHE=~/.cache/acer-current-profile
PROFILES=(quiet balanced performance gaming)

# Profile definitions: EC fan, CPU power-profiles-daemon, GPU watts
declare -A EC_VAL=([quiet]=1 [balanced]=2 [performance]=3 [gaming]=4)
declare -A CPU_PROFILE=([quiet]=power-saver [balanced]=balanced [performance]=performance [gaming]=performance)
declare -A GPU_WATTS=([quiet]=35 [balanced]=45 [performance]=60 [gaming]=75)

err() { echo "$1" >&2; exit 1; }

get_current() {
    if [[ -f "$CACHE" ]]; then
        read -r c < "$CACHE"
        [[ -n "$c" ]] && echo "$c" && return
    fi
    echo "balanced"
}

cmd_status() {
    echo "Profile: $(get_current)"
    echo ""
    if [[ -f "$SYS/all" ]]; then
        cat "$SYS/all"
    else
        echo "(acer_fanctl sysfs not available)"
    fi
    echo ""
    if command -v powerprofilesctl &>/dev/null; then
        echo "CPU: $(powerprofilesctl get 2>/dev/null || echo unknown)"
    fi
    if command -v nvidia-smi &>/dev/null; then
        local gpu_watts
        gpu_watts=$(nvidia-smi -q -d POWER 2>/dev/null | grep "Current Power Limit" | awk -F': *' '{print $2}' | awk '{print $1}' | head -1)
        echo "GPU: ${gpu_watts:-unknown}"
    fi
}

cmd_set() {
    local name="$1"

    [[ -v "EC_VAL[$name]" ]] || err "Invalid profile: $name. Use: ${PROFILES[*]}"

    local ec="${EC_VAL[$name]}"
    local cpu="${CPU_PROFILE[$name]}"
    local gpu="${GPU_WATTS[$name]}"

    # EC fan profile
    if [[ -f "$SYS/profile" ]]; then
        echo "$ec" > "$SYS/profile"
    fi

    # CPU power profile
    if command -v powerprofilesctl &>/dev/null; then
        powerprofilesctl set "$cpu" 2>/dev/null || true
    fi

    # GPU power limit
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi -pl "$gpu" 2>/dev/null || true
    fi

    # Cache state
    mkdir -p "$(dirname "$CACHE")"
    echo "$name" > "$CACHE"

    echo "Profile set to $name (EC=$ec, CPU=$cpu, GPU=${gpu}W)"
}

cmd_show() {
    echo "Usage: profile <${PROFILES[*]}>"
    echo ""
    echo "  quiet       - Silent: EC=1, CPU=power-saver, GPU=35W"
    echo "  balanced    - Default: EC=2, CPU=balanced, GPU=45W"
    echo "  performance - Fast: EC=3, CPU=performance, GPU=60W"
    echo "  gaming      - Max: EC=4, CPU=performance, GPU=75W"
}

case "${1:-}" in
    status|st)
        cmd_status
        ;;
    quiet|balanced|performance|gaming)
        cmd_set "$1"
        ;;
    help|--help|-h|"")
        cmd_show
        ;;
    *)
        err "Unknown profile: $1. Use: ${PROFILES[*]}"
        ;;
esac
